{
  "platform": "Linux-6.6.113+-x86_64-with-glibc2.35",
  "python": "3.12.13",
  "torch": "2.10.0+cu128",
  "cuda_available": true,
  "cuda_device": "NVIDIA A100-SXM4-40GB",
  "config": {
    "model_id": "Bllossom/llama-3.2-Korean-Bllossom-3B",
    "seed": 42,
    "device_dtype": "bf16",
    "attn_implementation": "eager",
    "trust_remote_code": false,
    "max_length": 128,
    "max_sentences": 180,
    "strict_josa_ratio": 0.5,
    "optional_corpus_txt": "/content/korean_josa_corpus.txt",
    "batch_size_activation": 2,
    "batch_size_attention": 1,
    "batch_size_quant": 2,
    "calibration_sample_per_layer_per_batch": 8192,
    "activation_quantiles": [
      99.0,
      99.5,
      99.9
    ],
    "primary_activation_quantile": 99.5,
    "topk_channels": 32,
    "min_sentence_pairs_per_layer": 8,
    "num_permutations": 300,
    "alpha": 0.05,
    "fake_quant_bits": 4,
    "fake_quant_match_trials": 5,
    "fake_quant_probe_layers": "auto",
    "matched_by_position_and_length": true,
    "num_heatmap_sentences": 6,
    "local_window": 3,
    "save_dpi": 160,
    "output_dir": "/content/korean_josa_sink_results"
  }
}